
{
  "app": {
    "signingConfigs": [],
    // @ohos/ffmpeg-kit 是字节码 HAR：鸿蒙工具链要求工程级打开
    // useNormalizedOHMUrl，否则生成 loader 时报告 00306046 规范限制错误。
    "useNormalizedOHMUrl": true,
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}