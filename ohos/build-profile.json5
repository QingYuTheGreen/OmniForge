
{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        // @ohos/ffmpeg-kit 是字节码 HAR：产品级 buildOption.strictMode 打开
        // useNormalizedOHMUrl，否则 GenerateLoaderJson 报 00306046；工程级
        // app 顶层不接受该字段（只允许 signingConfigs/products/...）。
        "buildOption": {
          "strictMode": {
            "useNormalizedOHMUrl": true
          }
        },
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}