
{
  // @ohos/ffmpeg-kit 是字节码 HAR：鸿蒙工具链要求工程级打开
  // useNormalizedOHMUrl（顶层字段，不能放在 app 节点内，否则 schema 校验
  // 报 00303038 Configuration Error），否则生成 loader 时报告 00306046。
  "useNormalizedOHMUrl": true,
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "profile"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}